# Where the SQLite database lives. Four slashes = absolute path.
DATABASE_URL=sqlite+aiosqlite:///./data/splitter.db

# Listen address for the web app (the tablet opens http://<host>:8100/).
HOST=0.0.0.0
PORT=8100

# Everything else (the gaming PC's IP, your player name, telemetry options)
# is set from the Settings page and stored in the database.
